{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  },
  "mcpServers": {
    "trigger": {
      "command": "npx",
      "args": ["trigger.dev@latest", "mcp"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx playwright install chromium"
          }
        ]
      }
    ]
  }
}
