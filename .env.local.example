# ScrappyPuffle Environment Variables
# Copy this file to .env.local and fill in your credentials

# ICSC Member Directory (requires paid membership)
ICSC_EMAIL=your-email@example.com
ICSC_PASSWORD=your-password

# Add other credentials here as needed for scrapers that require authentication

# Trigger.dev local development
# Required if you want local scripts to enqueue delayed/manual Trigger runs from code
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxx

# Optional: set to 0 for the full daily run, or a small number while validating
HIRING_CAFE_DAILY_MAX_PAGES=0
