{
  "name": "nyc-dob-scraper",
  "version": "1.0.0",
  "description": "Scraper for NYC DOB BIS - New Building permits and developer data",
  "scripts": {
    "scrape": "npx tsx scraper.ts",
    "scrape:manhattan": "npx tsx scraper.ts --borough 1",
    "scrape:bronx": "npx tsx scraper.ts --borough 2",
    "scrape:brooklyn": "npx tsx scraper.ts --borough 3",
    "scrape:queens": "npx tsx scraper.ts --borough 4",
    "scrape:staten": "npx tsx scraper.ts --borough 5"
  },
  "dependencies": {
    "playwright": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
